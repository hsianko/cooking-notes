<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="googlebot" content="noindex, nofollow">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="灶邊筆記">
<meta name="theme-color" content="#F7F1E4">
<title>灶邊筆記</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=IBM+Plex+Sans+TC:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap');

:root{
  --bg:#F7F1E4; --card:#FFFCF4; --cardBorder:#E6DCC4;
  --ink:#3B2F22; --muted:#9C8A6E; --sage:#7C8B5E; --sageDark:#5F6E45;
  --rust:#C1622C; --rustSoft:#EFDCC9;
}
*{box-sizing:border-box;}
body{
  margin:0; min-height:100vh; background:var(--bg); color:var(--ink);
  font-family:'IBM Plex Sans TC', sans-serif; padding-bottom:40px;
  -webkit-font-smoothing:antialiased;
}
input::placeholder, textarea::placeholder{ color:#B9AC91; }
select{ -webkit-appearance:none; appearance:none; }
button{ font-family:inherit; }

.header-wrap{
  padding:24px 20px 0; border-bottom:1px solid var(--cardBorder);
  background:linear-gradient(180deg,#FBF6EA,#F7F1E4);
}
.header-row{ display:flex; align-items:center; gap:12px; margin-bottom:18px; }
.logo{
  width:40px; height:40px; border-radius:12px; background:var(--rustSoft);
  display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:20px;
}
h1{ font-family:'Fraunces',serif; font-weight:600; font-size:22px; margin:0; letter-spacing:0.01em; }
.subtitle{ margin:2px 0 0; font-size:12.5px; color:var(--muted); }

.tab-row{ display:flex; gap:6px; }
.tab-btn{
  flex:1; padding:11px 10px; font-size:13.5px; font-weight:500;
  border:none; background:transparent; color:var(--muted); cursor:pointer;
  border-bottom:2px solid transparent; display:flex; align-items:center; justify-content:center;
}
.tab-btn.active{ color:var(--rust); border-bottom:2px solid var(--rust); font-weight:600; }
.count-badge{
  margin-left:6px; background:var(--rust); color:#fff; font-size:10.5px; font-weight:600;
  border-radius:20px; padding:1px 6px; font-family:'IBM Plex Mono',monospace;
}

.body-wrap{ padding:20px 20px 0; max-width:640px; margin:0 auto; }
.tabpanel{ display:none; }
.tabpanel.active{ display:block; }

.add-big-btn{
  width:100%; padding:13px; border-radius:12px; border:1.5px dashed var(--rust);
  background:var(--rustSoft); color:var(--rust); font-size:14px; font-weight:600;
  display:flex; align-items:center; justify-content:center; gap:8px; cursor:pointer;
  margin-bottom:18px;
}

.form-card{
  background:var(--card); border:1px solid var(--cardBorder); border-radius:14px;
  padding:18px; margin-bottom:20px; box-shadow:0 2px 10px rgba(59,47,34,0.05); display:none;
}
.form-card.show{ display:block; }
.form-head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; }
.form-title{ font-family:'Fraunces',serif; font-weight:600; font-size:16px; }
.icon-btn{ border:none; background:transparent; cursor:pointer; padding:4px; display:flex; align-items:center; }
label.field-label{ display:block; font-size:12px; color:var(--muted); margin-bottom:6px; margin-top:12px; font-weight:500; }
.field{
  width:100%; padding:10px 12px; border-radius:9px; border:1px solid var(--cardBorder);
  background:#FFFEFA; font-size:14px; color:var(--ink); font-family:inherit; box-sizing:border-box; outline:none;
}
textarea.field{ min-height:56px; resize:vertical; }
.row2{ display:flex; gap:12px; }
.save-btn{
  width:100%; margin-top:18px; padding:12px; border-radius:10px; border:none;
  background:var(--sage); color:#fff; font-size:14px; font-weight:600; cursor:pointer;
}

.empty{ display:flex; flex-direction:column; align-items:center; justify-content:center; padding:44px 20px; gap:10px; }
.empty-text{ color:var(--muted); font-size:13px; margin:0; }
.empty-icon{ font-size:30px; opacity:0.35; }

.list{ display:flex; flex-direction:column; gap:12px; }
.recipe-card{
  background:var(--card); border:1px solid var(--cardBorder); border-radius:14px; padding:16px;
  box-shadow:0 1px 6px rgba(59,47,34,0.04);
}
.recipe-top{ display:flex; justify-content:space-between; align-items:flex-start; }
.recipe-name{ font-family:'Fraunces',serif; font-weight:600; font-size:17px; }
.tag-row{ display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
.tag{ font-size:11.5px; padding:3px 9px; border-radius:20px; background:#EFE7D3; color:var(--sageDark); font-weight:500; }
.tag-time{ background:var(--rustSoft); color:var(--rust); font-family:'IBM Plex Mono',monospace; }
.notes-row{ display:flex; margin-top:10px; align-items:flex-start; font-size:12.5px; color:#6B5A42; line-height:1.5; }
.add-to-cart-btn{
  margin-top:12px; border:none; background:transparent; color:var(--sageDark);
  font-size:12.5px; font-weight:600; padding:0; cursor:pointer; display:flex; align-items:center;
}

.shop-input-row{ display:flex; gap:8px; margin-bottom:18px; }
.add-small-btn{
  width:42px; border-radius:9px; border:none; background:var(--sage); cursor:pointer;
  display:flex; align-items:center; justify-content:center; flex-shrink:0; color:#fff; font-size:20px; font-weight:600;
}
.shop-row{
  display:flex; align-items:center; gap:10px; background:var(--card);
  border:1px solid var(--cardBorder); border-radius:12px; padding:12px 14px;
}
.shop-row.checked{ opacity:0.55; }
.checkbox{
  width:19px; height:19px; border-radius:6px; border:1.5px solid var(--cardBorder);
  display:flex; align-items:center; justify-content:center; background:#FFFEFA; cursor:pointer; flex-shrink:0;
}
.checkbox.on{ background:var(--sage); border-color:var(--sage); color:#fff; font-size:12px; }
.shop-item-name{ font-size:14px; font-weight:500; }
.shop-item-name.checked{ text-decoration:line-through; color:var(--muted); }
.from-tag{ display:block; font-size:11px; color:var(--muted); margin-top:2px; }
.clear-btn{
  width:100%; margin-top:16px; padding:11px; border-radius:10px; border:1px solid var(--cardBorder);
  background:transparent; color:var(--muted); font-size:13px; cursor:pointer;
}

.toast{
  position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
  background:var(--ink); color:#FBF6EA; padding:10px 18px; border-radius:30px;
  font-size:12.5px; box-shadow:0 4px 16px rgba(0,0,0,0.2); opacity:0; pointer-events:none; transition:opacity .2s;
}
.toast.show{ opacity:1; }
</style>
</head>
<body>

<div class="header-wrap">
  <div class="header-row">
    <div class="logo">🍳</div>
    <div>
      <h1>灶邊筆記</h1>
      <p class="subtitle">烹煮方式 · 時間 · 採買清單
